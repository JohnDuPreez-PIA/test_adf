							"value": "@pipeline().parameters.p_DivisionCode",
							"type": "Expression"
						},
						"p_SleepMs": 1001
					}
				}
			},
			{
				"name": "ExtractJournals",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ExtractPeriods",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_entity",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
