{
	"name": "pl_extract_finance",
	"properties": {
		"activities": [
			{
				"name": "ExtractCRMAccounts",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_entity",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_BaseUrl": {
							"value": "@concat('https://start.exactonline.be/api/v1/', string(pipeline().parameters.p_DivisionCode), '/bulk/CRM/Accounts')",
							"type": "Expression"
						},
						"p_SelectFields": "ID,Code,Accountant,Email,Language,City,AddressLine1,Name,VATNumber,IsSupplier,Status,Phone,Country,Postcode,StartDate,EndDate,CustomField",
						"p_EntityName": "CRMAccounts",
						"p_Division": {
							"value": "@pipeline().parameters.p_DivisionCode",
							"type": "Expression"
						},
						"p_SleepMs": 1001
					}
				}
			},
			{
				"name": "ExtractGLAccounts",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ExtractCRMAccounts",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_entity",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_BaseUrl": {
							"value": "@concat('https://start.exactonline.be/api/v1/', string(pipeline().parameters.p_DivisionCode), '/bulk/Financial/GLAccounts')",
							"type": "Expression"
						},
						"p_SelectFields": "ID,BalanceType,Code,Description,Division",
						"p_EntityName": "GLAccounts",
