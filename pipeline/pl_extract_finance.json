				}
			},
			{
				"name": "ExtractPeriods",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ExtractDivisions",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_entity",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_BaseUrl": {
							"value": "@concat('https://start.exactonline.be/api/v1/', string(pipeline().parameters.p_DivisionCode), '/financial/FinancialPeriods')",
							"type": "Expression"
						},
						"p_SelectFields": "ID,Division,EndDate,FinPeriod,FinYear,StartDate",
						"p_EntityName": "Periods",
