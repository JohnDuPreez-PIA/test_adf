							"value": "@pipeline().parameters.p_DivisionCode",
							"type": "Expression"
						},
						"p_SleepMs": 1001,
						"p_ExtraHeaders": "{\"CustomDescriptionLanguage\":\"NL\"}"
					}
				}
			},
			{
				"name": "ExtractDivisions",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ExtractGLAccounts",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_entity",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
