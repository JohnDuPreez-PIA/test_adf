{
	"name": "pl_master_exactonline",
	"properties": {
		"activities": [
			{
				"name": "GetDivisions",
				"type": "AzureFunctionActivity",
				"linkedServiceName": {
					"referenceName": "ls_func_exactonline",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"functionName": "get_divisions",
					"method": "GET"
				},
				"policy": {
					"timeout": "00:02:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				}
			},
			{
				"name": "SetDivisions",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetDivisions",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"typeProperties": {
					"variableName": "v_Divisions",
					"value": {
						"value": "@activity('GetDivisions').output.divisions",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SetYears",
				"type": "SetVariable",
				"typeProperties": {
					"variableName": "v_Years",
					"value": {
						"value": "@createArray(sub(int(formatDateTime(utcNow(), 'yyyy')), 2), sub(int(formatDateTime(utcNow(), 'yyyy')), 1), int(formatDateTime(utcNow(), 'yyyy')), add(int(formatDateTime(utcNow(), 'yyyy')), 1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachDivision",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "SetYears",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SetDivisions",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"typeProperties": {
					"isSequential": true,
					"items": {
						"value": "@if(greater(length(pipeline().parameters.p_Divisions), 0), pipeline().parameters.p_Divisions, variables('v_Divisions'))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "ExtractFinance",
							"type": "ExecutePipeline",
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_extract_finance",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_DivisionCode": {
										"value": "@item()",
										"type": "Expression"
									},
									"p_Years": {
										"value": "@variables('v_Years')",
										"type": "Expression"
									},
									"p_ModifiedSince": {
										"value": "@pipeline().parameters.p_ModifiedSince",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "ExtractOperations",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ForEachDivision",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_extract_operations",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_ModifiedSince": {
							"value": "@pipeline().parameters.p_ModifiedSince",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "RunDatabricksBronzeLoad",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ExtractOperations",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"linkedServiceName": {
					"referenceName": "ls_databricks_test",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"notebookPath": "/Shared/exactonline/nb_exactonline_bronze_load"
				},
				"policy": {
					"timeout": "04:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 300
				}
			}
		],
		"parameters": {
			"p_Divisions": {
				"type": "Array",
				"defaultValue": []
			},
			"p_ModifiedSince": {
				"type": "String",
				"defaultValue": ""
			}
		},
		"variables": {
			"v_Years": {
				"type": "Array"
			},
			"v_Divisions": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-02-17T13:29:27Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
